# Server Port
PORT=5000

# Option 1: Local MongoDB Connection (Default)
MONGODB_URI=mongodb://127.0.0.1:27017/moviewatchlist

# Option 2: MongoDB Atlas (Cloud) Connection
# Replace <username>, <password>, and <cluster-url> with your credentials:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/moviewatchlist?retryWrites=true&w=majority
