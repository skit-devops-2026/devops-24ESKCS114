{
  "name": "movforyou",
  "version": "2.0.0",
  "description": "MovForYou - Premium Cinematic Movie Platform & Watchlist Web Application",
  "main": "server/server.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node server/server.js",
    "dev": "concurrently -k \"nodemon server/server.js\" \"vite --config client/vite.config.mjs --host 0.0.0.0\"",
    "build": "vite build --config client/vite.config.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "movie",
    "watchlist",
    "cinematic",
    "movforyou",
    "express",
    "mongodb",
    "nodejs",
    "javascript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.9",
    "vite": "^8.3.4"
  }
}
